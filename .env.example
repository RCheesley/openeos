# Copy this file to .env and fill in real values.
# These defaults work for local development with docker compose up.
# Change the passwords and keys before running in production.

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=epd_db
DB_USER=epd_user
DB_PASSWORD=epd_password
# Hostname of the Postgres service (docker-compose.prod.yml names it "db")
DB_HOST=db
DB_PORT=5432

# The db service in docker-compose.prod.yml reads these to create the
# database on first start; keep them in step with the DB_* values above.
POSTGRES_DB=epd_db
POSTGRES_USER=epd_user
POSTGRES_PASSWORD=epd_password

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production-please

DEBUG=True
# A leading-dot entry such as .example.com also covers every organisation
# subdomain (acme.example.com) set up under Organization domains.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── First superuser (created automatically on first boot if not present) ──────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass

# ── Production overrides (uncomment and set when deploying) ───────────────────
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# SECRET_KEY=<long-random-string>
# DB_PASSWORD=<strong-password>
# DJANGO_SUPERUSER_PASSWORD=<strong-password>

# ── Media (production Nginx serves avatars after Django checks the request) ──
# Set True whenever nginx/nginx.conf is in front of Django; leave unset without a proxy.
# MEDIA_ACCEL_REDIRECT=True

# ── TLS / HTTPS (only when TLS terminates at Nginx or a load balancer) ────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ── Sign-in protection ────────────────────────────────────────────────────────
# Wrong passwords allowed before a lock-out: for one username, and from one
# address across all usernames. 0 switches that limit off.
# SIGN_IN_FAILURE_LIMIT=5
# SIGN_IN_ADDRESS_FAILURE_LIMIT=20
# The first lock-out lasts this many seconds and doubles with each further
# failure, up to the maximum. SIGN_IN_LOCKOUT_SECONDS=0 switches lock-outs off.
# SIGN_IN_LOCKOUT_SECONDS=60
# SIGN_IN_LOCKOUT_MAX_SECONDS=3600
# Failures are forgotten this long after the last one or after a lock-out ends.
# SIGN_IN_FAILURE_WINDOW_SECONDS=900
# Password reset requests accepted from one address, and reset emails sent to
# one email address, in each window. 0 switches that limit off.
# PASSWORD_RESET_ADDRESS_LIMIT=10
# PASSWORD_RESET_EMAIL_LIMIT=3
# PASSWORD_RESET_WINDOW_SECONDS=3600
# Sign a user out after this many minutes without activity. 0 switches it off.
# A running meeting keeps its facilitator signed in.
# SESSION_IDLE_TIMEOUT_MINUTES=720
# Reverse proxies in front of Django that add to X-Forwarded-For. Leave unset
# for the bundled Nginx (counted as 1 in production, 0 in development). Set 2
# when a load balancer or tunnel sits in front of that Nginx, otherwise every
# visitor appears to come from the load balancer and shares one address limit.
# TRUSTED_PROXY_COUNT=1

# ── Logging ───────────────────────────────────────────────────────────────────
# DJANGO_LOG_LEVEL=WARNING

# ── Extra Django apps ─────────────────────────────────────────────────────────
# Comma-separated apps appended to INSTALLED_APPS (third-party or private
# packages that are installed in the image), e.g. django.contrib.sites
# EXTRA_INSTALLED_APPS=

# ── Email (leave EMAIL_HOST unset to print emails to the console instead) ─────
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=<smtp-password-or-api-key>
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Empresadence <noreply@yourdomain.com>
# SITE_URL=https://yourdomain.com

# ── Branding ──────────────────────────────────────────────────────────────────
# Default name shown in the navbar, page titles and emails. Each organisation
# can override it (and its logo, colours and more) under Organisation → Settings.
# BRAND_NAME=Empresadence
